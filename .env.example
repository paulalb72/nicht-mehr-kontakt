# Einmalig mit "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"" erzeugen.
TOKEN_SECRET=HIER_64_HEX_ZEICHEN_EINTRAGEN
PUBLIC_BASE_URL=https://abmelden.example.de

# Gmail-Adresse und Google-App-Passwort des sendenden Kontos.
SMTP_USER=mein.konto@gmail.com
SMTP_APP_PASSWORD=HIER_APP_PASSWORT_EINTRAGEN
NOTIFY_TO=mein.konto@gmail.com

# Optional: Standardwerte sind 127.0.0.1:3000 und data/optouts.json.
HOST=127.0.0.1
PORT=3000
